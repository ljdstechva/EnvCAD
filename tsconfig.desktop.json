{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "desktop/**/*.ts",
    "sidecar/src/**/*.ts",
    "src/agent/protocol.ts",
    "forge.env.d.ts"
  ]
}
