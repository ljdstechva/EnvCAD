{
  "name": "envcad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencyNotes": {
    "@mlightcad/*": "Pinned to exact versions on purpose — no ^ ranges. src/agent/polyline.ts reads vertex positions and bulges through public APIs, validates that both views align, and falls back to straight chord vertices when bulges cannot be verified. The pin keeps upgrades deliberate and testable. See docs/agent-test-plan.md."
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,sidecar -c blue,green \"vite\" \"npm run sidecar\"",
    "sidecar": "tsx sidecar/src/index.ts",
    "typecheck": "vue-tsc -b --pretty false && tsc -p sidecar/tsconfig.json --pretty false",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:fixture": "tsx test/fixtures/generate-sample-site.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@mlightcad/cad-agent-plugin": "1.5.8",
    "@mlightcad/cad-simple-viewer": "1.5.8",
    "@mlightcad/cad-svg-plugin": "1.5.8",
    "@mlightcad/data-model": "1.12.0",
    "jspdf": "^2.5.2",
    "lodash-es": "4.17.21",
    "svg2pdf.js": "^2.2.3",
    "three": "^0.172.0",
    "vue": "^3.4.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/ui": "^2.1.0",
    "concurrently": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
