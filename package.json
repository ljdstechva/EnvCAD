{
  "name": "envcad",
  "productName": "EnvCAD",
  "private": true,
  "version": "0.2.0",
  "description": "Environmental CAD drafting with a secure multi-provider AI Assistant",
  "author": "ljdstechva",
  "main": ".vite/build/main.cjs",
  "type": "module",
  "dependencyNotes": {
    "@mlightcad/*": "Pinned to exact versions on purpose — no ^ ranges. src/agent/polyline.ts reads vertex positions and bulges through public APIs, validates that both views align, and falls back to straight chord vertices when bulges cannot be verified. The pin keeps upgrades deliberate and testable. See docs/agent-test-plan.md."
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "concurrently --kill-others-on-fail -n vite,sidecar -c blue,green \"vite\" \"npm run sidecar\"",
    "sidecar": "tsx sidecar/src/index.ts",
    "typecheck": "vue-tsc -b --pretty false && tsc -p sidecar/tsconfig.json --pretty false && tsc -p tsconfig.desktop.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:ai": "tsx scripts/aiBenchmark.ts",
    "desktop:dev": "electron-forge start",
    "desktop:package": "electron-forge package --platform=win32 --arch=x64",
    "desktop:make": "electron-forge make --platform=win32 --arch=x64",
    "test:desktop": "electron-forge package --platform=win32 --arch=x64 && playwright test --config=playwright.desktop.config.ts",
    "desktop:icon": "node scripts/generateDesktopIcon.mjs",
    "gen:fixture": "tsx test/fixtures/generate-sample-site.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@mlightcad/cad-simple-viewer": "1.5.8",
    "@mlightcad/cad-svg-plugin": "1.5.8",
    "@mlightcad/data-model": "1.12.0",
    "electron-log": "5.4.4",
    "electron-squirrel-startup": "1.0.1",
    "jspdf": "4.2.1",
    "lodash-es": "4.17.21",
    "sirv": "3.0.2",
    "svg2pdf.js": "^2.2.3",
    "three": "^0.172.0",
    "vue": "^3.4.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/fuses-v2": "npm:@electron/fuses@2.1.3",
    "@playwright/test": "^1.62.0",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/ui": "^2.1.0",
    "concurrently": "^9.0.0",
    "electron": "43.2.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "png-to-ico": "3.0.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
